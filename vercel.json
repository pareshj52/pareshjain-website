      "destination": "/#contact",
      "permanent": true
    },
    {
      "source": "/terms.html",
      "destination": "/privacy.html",
      "permanent": true
    },
    {
      "source": "/accessibility.html",
      "destination": "/privacy.html",
      "permanent": true
    },
    {
      "source": "/robots.html",
      "destination": "/robots.txt",
      "permanent": true
    },
    {
      "source": "/campaign-ford.html",
      "destination": "/#work",
      "permanent": true
